{
  "name": "aio-converter",
  "version": "0.2.0",
  "description": "Private, offline file conversion for Windows",
  "author": "AIO Converter contributors",
  "license": "MIT",
  "type": "module",
  "main": "dist-electron/main.cjs",
  "scripts": {
    "postinstall": "node node_modules/electron/install.js",
    "dev": "node scripts/dev.mjs",
    "build": "tsc --noEmit && vite build && node scripts/build-main.mjs",
    "test": "tsx --test tests/*.test.ts",
    "engines": "node scripts/acquire-engines.mjs",
    "test:downloads": "tsx scripts/test-downloads.ts",
    "test:engines": "tsx scripts/smoke-engines.ts",
    "test:matrix": "tsx scripts/test-matrix.ts",
    "pack": "npm run build && electron-builder --win --x64 --dir",
    "dist": "npm run build && node scripts/check-vendor.mjs && electron-builder --win nsis --x64 --publish never && node scripts/checksum.mjs",
    "preview": "vite --host 127.0.0.1"
  },
  "build": {
    "appId": "org.aioconverter.desktop",
    "productName": "AIO Converter",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "dist-electron/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "vendor",
        "to": "engines",
        "filter": [
          "**/*",
          "!*-unpacked{,/**/*}",
          "!**/*.msi"
        ]
      },
      {
        "from": "THIRD-PARTY-NOTICES.md",
        "to": "THIRD-PARTY-NOTICES.md"
      }
    ],
    "asar": true,
    "electronDist": "node_modules/electron/dist",
    "win": {
      "target": "nsis",
      "artifactName": "AIO-Converter-Setup-${version}.${ext}",
      "icon": "public/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowElevation": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "deleteAppDataOnUninstall": false,
      "license": "LICENSE"
    }
  },
  "devDependencies": {
    "@types/node": "22.20.5",
    "electron": "45.1.0",
    "electron-builder": "26.18.0",
    "esbuild": "0.25.12",
    "playwright": "1.64.1",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "vite": "7.3.7"
  }
}
